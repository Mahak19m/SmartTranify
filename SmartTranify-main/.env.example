# =================================================================
# SmartTranify Environment Configuration
# =================================================================

# Database Connection URL
# If DB_URL is left empty or commented out, SmartTranify defaults to SQLite (sqlite:///./smarttranify.db)
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/smarttranify
DB_URL=

# JWT Authentication Secret Key
# Replace with a high-entropy 256-bit secret in production
SECRET_KEY=smarttranify-super-secret-production-jwt-key-3849

# JWT Algorithm and Expiration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Google Gemini API Key for AI Coaching & Analysis (Optional fallback active if missing)
GEMINI_API_KEY=
