# =================================================================
# SmartTranify Environment Configuration (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. Database Connection URL
# -----------------------------------------------------------------
# If DB_URL is left empty or commented out, SmartTranify defaults automatically
# to SQLite (sqlite:///./smarttranify.db), requiring zero external setup.
# For production PostgreSQL:
# DB_URL=postgresql://postgres:your_password@localhost:5432/smarttranify
DB_URL=

# -----------------------------------------------------------------
# 2. JWT Authentication Secrets
# -----------------------------------------------------------------
# Replace with a high-entropy secret key in production (e.g. openssl rand -hex 32)
SECRET_KEY=smarttranify-super-secret-production-jwt-key-3849
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------
# 3. Allowed Frontend Origins for CORS
# -----------------------------------------------------------------
# Comma-separated list of origins allowed to make cross-origin requests
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------
# 4. Google Gemini API Key for AI Coaching & Form Q&A (Optional)
# -----------------------------------------------------------------
# If set, SmartTranify connects directly to Google Gemini 1.5 Flash for coach chat.
# If omitted, SmartTranify's built-in certified biomechanical coach engine runs seamlessly.
GEMINI_API_KEY=

# -----------------------------------------------------------------
# 5. Frontend Environment Configuration (for Vite client)
# -----------------------------------------------------------------
# Backend API Base URL (defaults to http://localhost:8000 if omitted)
VITE_API_URL=http://localhost:8000
